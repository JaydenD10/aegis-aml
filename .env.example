# AegisAML - Production Environment Variables Example
# Duplicate this file as .env in production / server environments

# ----------------------------------------------------
# DATABASE CONFIGURATION
# ----------------------------------------------------
# Unified PostgreSQL connection string (Render, Neon, Supabase, AWS RDS, Railway)
DATABASE_URL=postgresql://postgres_user:postgres_password@localhost:5432/aegisaml

# Alternative granular parameters if DATABASE_URL is not set:
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_secure_password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=aegisaml

# ----------------------------------------------------
# SECURITY & AUTHENTICATION
# ----------------------------------------------------
AEGIS_SECRET_KEY=your_super_secret_jwt_hmac_key_min_32_characters

# ----------------------------------------------------
# CORS & FRONTEND ROUTING
# ----------------------------------------------------
FRONTEND_URL=https://your-frontend.vercel.app
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# ----------------------------------------------------
# CLIENT-SIDE ENVIRONMENT VARIABLE (FOR FRONTEND)
# ----------------------------------------------------
# NEXT_PUBLIC_API_URL=https://your-backend.onrender.com
